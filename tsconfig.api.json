{
  "include": [
    "api/**/*"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
